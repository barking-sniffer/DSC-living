---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro'
import StickyBar from '../components/StickyBar.astro'
import HomeHero from '../components/sections/home/HomeHero.astro'
import WhatWeDo from '../components/sections/home/WhatWeDo.astro'
import AllServicesRoof from '../components/sections/home/AllServicesRoof.astro'
import SectorCards from '../components/sections/home/SectorCards.astro'
import AiUpgrade from '../components/sections/home/AiUpgrade.astro'
import PricingClose from '../components/sections/home/PricingClose.astro'
---

<Base
  lang="nl"
  path="/"
  altPath="/en/"
  title="Vastgoedbeheer Hoofddorp en Amstelveen | DSC Living"
  description="Eén partij voor schoonmaak, tuin, ramen en onderhoud van uw woning of bedrijfspand in Hoofddorp, Amstelveen en Amsterdam. Beheer vanaf €89 per maand."
>
  <Header locale="nl" path="/" altPath="/en/" />
  <main>
    <HomeHero locale="nl" />
    <WhatWeDo locale="nl" />
    <AllServicesRoof locale="nl" />
    <SectorCards locale="nl" />
    <AiUpgrade locale="nl" />
    <PricingClose locale="nl" />
  </main>
  <Footer locale="nl" />
  <FloatingWhatsApp />
  <StickyBar locale="nl" />
</Base>
