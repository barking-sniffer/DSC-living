---
// Fonts are self-hosted from the @fontsource packages, but with our own
// @font-face rules in global.css pointing at public/fonts/ (copied from
// node_modules/@fontsource/*/files at build time) rather than importing
// fontsource's CSS directly — that keeps the file URLs stable so the
// <link rel="preload"> below actually matches the served file.
import '../styles/global.css'
import { company } from '../data/company'

interface Props {
  lang: 'nl' | 'en'
  path: string // the current page's own path, e.g. '/wonen/schoonmaak/'
  altPath: string // the exact counterpart path in the other locale —
  // passed explicitly rather than derived, because NL and EN slugs are
  // no longer mechanical prefix-swaps of each other (e.g.
  // /wonen/schoonmaak/ <-> /en/residential/cleaning/).
  title: string
  description: string
  h1?: string // when present, adds a Service JSON-LD node
  serviceType?: string
  ogImage?: string
}

const {
  lang,
  path,
  altPath,
  title,
  description,
  serviceType,
  ogImage = '/images/og.jpg',
} = Astro.props

const siteUrl = 'https://dscliving.nl'
const canonical = `${siteUrl}${path}`
const nlPath = lang === 'nl' ? path : altPath
const enPath = lang === 'nl' ? altPath : path
const locale = lang === 'nl' ? 'nl_NL' : 'en_GB'

const localBusinessId = `${siteUrl}/#business`

const graph: Record<string, unknown>[] = [
  {
    '@type': 'HomeAndConstructionBusiness',
    '@id': localBusinessId,
    name: company.name,
    legalName: company.legalName,
    url: siteUrl,
    telephone: company.phone,
    email: company.email,
    image: `${siteUrl}${ogImage}`,
    priceRange: company.priceRange,
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.address.street,
      postalCode: company.address.postcode,
      addressLocality: company.address.city,
      addressCountry: company.address.country,
    },
    areaServed: company.areaServed.map((city) => ({ '@type': 'City', name: city })),
    ...(company.kvk && !company.kvk.includes('[[')
      ? { identifier: { '@type': 'PropertyValue', name: 'KvK', value: company.kvk } }
      : {}),
    ...(company.btw && !company.btw.includes('[[') ? { vatID: company.btw } : {}),
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
      description: '24/7 support line',
    },
    sameAs: Object.values(company.social),
  },
]

if (serviceType) {
  graph.push({
    '@type': 'Service',
    serviceType,
    areaServed: company.areaServed.map((city) => ({ '@type': 'City', name: city })),
    provider: { '@id': localBusinessId },
  })
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph }
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="nl" href={`${siteUrl}${nlPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${nlPath}`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Preload both display faces for fast LCP -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/newsreader-latin-400-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/karla-latin-400-normal.woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      Analytics: Plausible, EU-hosted and cookieless. No consent banner
      needed because no cookies are set and no personal data is processed.
    -->
    <script is:inline defer data-domain="dscliving.nl" src="https://plausible.io/js/script.outbound-links.js"></script>
  </head>
  <body class="bg-paper">
    <slot />

    <script>
      // Fire a Plausible custom event, labelled by location, for every
      // outbound WhatsApp click. This is the only conversion metric in
      // phase 1 — every CtaButton and direct wa.me link carries
      // data-wa-location so this single listener covers the whole site.
      document.addEventListener('click', (event) => {
        const target = (event.target as HTMLElement)?.closest('[data-wa-cta]') as HTMLElement | null
        if (!target) return
        const location = target.getAttribute('data-wa-location') || 'unknown'
        const kind = target.getAttribute('data-wa-kind') || 'unknown'
        const plausible = (window as typeof window & {
          plausible?: (event: string, opts?: { props?: Record<string, string> }) => void
        }).plausible
        if (typeof plausible === 'function') {
          plausible('WhatsApp Click', { props: { location, kind } })
        }
      })
    </script>
  </body>
</html>
