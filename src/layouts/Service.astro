---
// Shared shell for every full-content service/hub page (brief §10.1,
// §3.5). Handles Base + Header + Footer + breadcrumbs + hero band +
// closing CTA; the page file supplies only its own body content via the
// default slot.
import Base from './Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro'
import StickyBar from '../components/StickyBar.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Figure from '../components/Figure.astro'
import CtaButton from '../components/CtaButton.astro'
import { auditMessage, waMessages } from '../lib/whatsapp'

interface Crumb {
  label: string
  href?: string
}

interface Props {
  locale: 'nl' | 'en'
  path: string
  altPath: string
  title: string
  description: string
  serviceType?: string
  h1: string
  lead: string
  breadcrumbs: Crumb[]
  heroImage?: { src: string; alt: string; note: string }
  ctaLabel?: string
}

const { locale, path, altPath, title, description, serviceType, h1, lead, breadcrumbs, heroImage, ctaLabel } =
  Astro.props
const isNl = locale === 'nl'
const cta = ctaLabel ?? (isNl ? 'Plan uw gratis opname' : 'Book your free audit')
---

<Base lang={locale} path={path} altPath={altPath} title={title} description={description} serviceType={serviceType}>
  <Header locale={locale} path={path} altPath={altPath} />
  <main>
    <div class="content-wrap px-5 md:px-14">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <section class="px-5 pb-6 md:px-14">
      <div class="content-wrap max-w-[70ch]">
        <h1 class="h1 mb-4">{h1}</h1>
        <p class="lead mb-6">{lead}</p>
        <CtaButton kind="audit" message={auditMessage(locale)} location="service-hero" size="lg">{cta}</CtaButton>
      </div>
    </section>

    {heroImage && (
      <section class="px-5 pb-10 md:px-14">
        <div class="content-wrap">
          <Figure src={heroImage.src} alt={heroImage.alt} note={heroImage.note} ratio="21/9" class="rounded-[3px]" />
        </div>
      </section>
    )}

    <div class="content-wrap px-5 md:px-14">
      <div class="max-w-[70ch]">
        <slot />
      </div>
    </div>

    <section class="section">
      <div class="content-wrap flex flex-col items-start gap-5 rounded-[3px] bg-tint p-8 md:flex-row md:items-center md:justify-between">
        <div class="max-w-[48ch]">
          <h2 class="h3 mb-1">{isNl ? 'Klaar om te beginnen?' : 'Ready to get started?'}</h2>
          <p class="body-copy">
            {isNl
              ? 'Gratis, vrijblijvend, en een schriftelijk voorstel binnen twee werkdagen.'
              : 'Free, no obligation, and a written proposal within two working days.'}
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <CtaButton kind="audit" message={auditMessage(locale)} location="service-close" size="lg">{cta}</CtaButton>
          <CtaButton kind="question" message={waMessages.question} location="service-close-whatsapp" variant="outline" size="lg">
            {isNl ? 'WhatsApp ons' : 'WhatsApp us'}
          </CtaButton>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
  <FloatingWhatsApp />
  <StickyBar locale={locale} />
</Base>
