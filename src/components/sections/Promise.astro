---
import type { Dict } from '../../i18n/en'
import Figure from '../Figure.astro'
import { images } from '../../data/images'

interface Props {
  t: Dict
}

const { t } = Astro.props
const img = images.promise

const icons = [
  'M12 2L20 6V11C20 16 16.4 20.2 12 22C7.6 20.2 4 16 4 11V6L12 2Z',
  'M7 10V7a5 5 0 0110 0v3M5 10h14v10H5z',
  'M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8',
  'M12 2L3 7v6c0 5 4 9 9 9s9-4 9-9V7z',
  'M4 20l4-2 12-12-2-2L6 16z',
  'M4 6h16M4 12h16M4 18h16',
]
---

<section id="promise-detail" class="section bg-ink text-onDarkSoft">
  <div class="content-wrap grid grid-cols-1 gap-10 md:grid-cols-[1fr_1.3fr] md:gap-14">
    <div class="order-1">
      <Figure src={img.src} alt={img.alt} note={img.note} ratio="4/5" dark class="rounded-[3px]" />
    </div>

    <div class="order-2">
      <p class="eyebrow mb-3">{t.promise.eyebrow}</p>
      <h2 class="h2 text-onDark mb-4">{t.promise.h2}</h2>
      <p class="lead text-onDarkSoft mb-8 max-w-[52ch]">{t.promise.lead}</p>

      <div class="grid grid-cols-1 gap-7 sm:grid-cols-2">
        {t.promise.items.map((item, i) => (
          <div>
            <svg class="mb-3 h-6 w-6 text-accentLt" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={icons[i % icons.length]} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h3 class="h3 text-onDark mb-1">{item.title}</h3>
            <p class="body-copy text-onDarkSoft">{item.description}</p>
          </div>
        ))}
      </div>

      <p class="small-copy mt-9 border-t border-darkRule pt-6">{t.promise.footerNote}</p>
    </div>
  </div>
</section>
