---
// Brief Part 7.6. This restates facts already established on /wonen
// (VOG screening, liability cover) rather than inventing new claims —
// the figure is sourced from company.ts so it can never drift out of
// sync with the one place that number is allowed to live.
import { company } from '../../../data/company'

interface Props {
  locale: 'nl' | 'en'
}
const { locale } = Astro.props
const isNl = locale === 'nl'
const safetyHref = isNl ? '/veiligheid/' : '/en/safety/'
---

<section class="section bg-ink text-onDarkSoft">
  <div class="content-wrap max-w-[68ch]">
    <h2 class="h2 text-onDark mb-4">{isNl ? 'Wie er bij u komt' : 'Who comes to your property'}</h2>
    <p class="lead text-onDarkSoft mb-5">
      {isNl
        ? `Iedereen die bij u werkt is in dienst van ${company.name}, met een Nederlandse arbeidsovereenkomst. Zij worden gescreend vóór hun eerste bezoek, dragen een pas met foto, en u weet vooraf wie er komt. Ons werk is gedekt door een bedrijfsaansprakelijkheidsverzekering.`
        : `Everyone who works at your property is employed by ${company.name}, under a Dutch employment contract. They are screened before their first visit, carry a photo identity card, and you are told who is coming beforehand. Our work is covered by business liability insurance.`}
    </p>
    <a href={safetyHref} class="text-[13px] font-bold text-accentLt hover:underline">
      {isNl ? 'Ons veiligheidsbeleid →' : 'Our safety and security policy →'}
    </a>
  </div>
</section>
