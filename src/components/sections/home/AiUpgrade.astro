---
// CR-01 Part 6 — AI offerings.
//
// The "in development" label was REMOVED on 18 Sept 2026 at the client's
// explicit instruction. CR-01 §6.1 had called it "not optional": without
// it, "Explore our AI offerings" invites people to something that does
// not exist yet, which is Art. 6:193c BW (misleading commercial practice)
// territory. The closing line ("we will build that one first") is now the
// only remaining signal that these are not live. Restore the label if
// legal review asks for it.
//
// "AI financial insights", not "manager" — manager implies discretion
// over funds, which edges toward AFM-licensed activity.
// Excluded from structured data: nothing in this section emits JSON-LD
// (guard 18 checks this).
import Figure from '../../Figure.astro'
import CtaButton from '../../CtaButton.astro'
import { images } from '../../../data/images'
import { aiInterestMessage } from '../../../lib/whatsapp'

interface Props {
  locale: 'nl' | 'en'
}
const { locale } = Astro.props
const isNl = locale === 'nl'
const img = images.aiPlaceholder

const items = isNl
  ? [
      { t: 'Automatiseer uw woning en kantoor.', d: 'Verwarming, verlichting en toegang die meebewegen met hoe het pand werkelijk wordt gebruikt, ingericht en onderhouden door hetzelfde team dat de rest verzorgt.' },
      { t: 'Virtueel bezichtigen.', d: 'Loop rustig door een pand voordat u ernaartoe reist.' },
      { t: 'AI-inzicht in uw kosten.', d: 'Wat uw pand kost om te draaien, wat eraan komt, en waar het geld werkelijk heen gaat.' },
    ]
  : [
      { t: 'Automate your home and office.', d: 'Heating, lighting and access that respond to how the building is actually used, set up and looked after by the same team that looks after everything else.' },
      { t: 'Virtual property viewing.', d: 'Walk through a property properly before you travel to it.' },
      { t: 'AI financial insights.', d: 'What your property costs to run, what is coming next, and where the money actually goes.' },
    ]
---

<section class="section bg-tint" data-section="ai" data-no-schema>
  <div class="content-wrap grid grid-cols-1 items-start gap-10 md:grid-cols-2">
    <div>
      <h2 class="h2 mb-5">
        {isNl ? 'Ontdek onze AI-diensten voor comfortabeler wonen' : 'Explore our AI offerings to make your living more comfortable'}
      </h2>
      <div class="flex flex-col gap-4 mb-6">
        {items.map((it) => (
          <p class="body-copy"><strong class="text-ink">{it.t}</strong> {it.d}</p>
        ))}
      </div>
      <p class="body-copy font-semibold text-inkSoft mb-6">
        {isNl
          ? 'Laat weten welke u zou gebruiken, dan bouwen wij die als eerste.'
          : 'Tell us which of these you would use and we will build that one first.'}
      </p>
      <CtaButton kind="question" message={aiInterestMessage(locale)} location="ai-offerings" variant="outline" size="md">
        {isNl ? 'Houd mij op de hoogte →' : 'Register your interest →'}
      </CtaButton>
    </div>
    <Figure src={img.src} alt={img.alt} note={img.note} ratio="16/9" class="rounded-[3px]" />
  </div>
</section>
