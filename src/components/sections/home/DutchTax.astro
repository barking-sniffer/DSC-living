---
// CR-01 Part 7 — Dutch tax, delivered by DSC Capital (a different trading
// name; its own terms and privacy statement govern it). Links OUT to DSC
// Capital rather than into the DSC Living WhatsApp inbox. No structured
// data here.
//
// Headline/body replaced 18 Sept 2026 at the client's request. Note this
// widens the offer beyond tax to "legal support" and to foreign-held
// assets under Box 3 — CR-01 section 7.1 had deliberately kept the claim
// narrow, since advising on what someone should hold is Wft-regulated
// and supervised by the AFM, while preparing a return is not. Worth a
// legal read before this drives real enquiries.
//
// company.dscCapitalUrl is empty until a real URL is supplied; until then
// the CTA renders as plain text rather than a dead or guessed link.
import { company } from '../../../data/company'

interface Props {
  locale: 'nl' | 'en'
}
const { locale } = Astro.props
const isNl = locale === 'nl'
const url = company.dscCapitalUrl
const ctaLabel = isNl ? 'Ga naar DSC Capital →' : 'Go to DSC Capital →'
---

<section class="section bg-ink text-onDarkSoft" data-section="tax" data-no-schema>
  <div class="content-wrap">
  <div class="max-w-[68ch]">
    <h2 class="h2 text-onDark mb-3">
      {isNl ? 'Fiscale en juridische ondersteuning voor uw pand' : 'Tax & legal support for your property'}
    </h2>
    <p class="mb-6 text-[12px] font-bold uppercase tracking-[0.12em] text-accentLt" data-label>
      {isNl ? 'Uitgevoerd door DSC Capital' : 'Delivered by DSC Capital'}
    </p>
    <p class="lead text-onDarkSoft mb-6">
      {isNl
        ? 'Belastingen, erfopvolging en aanverwante zaken rond een pand kunnen ingewikkeld zijn. Wij zorgen dat u tijdens het hele traject gemoedsrust heeft. Ook box 3 nemen wij mee, als u vermogen in het buitenland heeft.'
        : 'Taxation, inheritance and similar matters around a property can be challenging. We make sure you have peace of mind throughout the process. We also cover Box 3 if you hold assets in other countries.'}
    </p>
    {url ? (
      <a href={url} target="_blank" rel="noopener" class="text-[13px] font-bold text-accentLt hover:underline">{ctaLabel}</a>
    ) : (
      <span class="text-[13px] font-bold text-onDarkMute">{isNl ? 'DSC Capital — binnenkort online' : 'DSC Capital — website coming soon'}</span>
    )}
  </div>
  </div>
</section>
