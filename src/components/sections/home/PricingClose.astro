---
// CR-01 Part 5 — Membership from €20 a month, replacing the €89 care and
// oversight block. The figure comes from company.membership. The copy
// never implies €20 buys any service delivery: it is the membership, and
// services are quoted separately against the approved job sheet.
import CtaButton from '../../CtaButton.astro'
import { company } from '../../../data/company'
import { auditMessage, whatsappQuestionMessage } from '../../../lib/whatsapp'

interface Props {
  locale: 'nl' | 'en'
}
const { locale } = Astro.props
const isNl = locale === 'nl'
---

<section id="membership" class="section bg-tint">
  <div class="content-wrap flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-[58ch]">
      <h2 class="h2 mb-4">
        {isNl
          ? `Lidmaatschap vanaf ${company.membership.displayNL} per maand`
          : `Membership from ${company.membership.displayEN} a month`}
      </h2>
      <p class="lead mb-4">
        {isNl
          ? `Het begint met een lidmaatschap. Voor ${company.membership.displayNL} per maand staat uw pand bij ons geregistreerd: wij houden uw panddossier bij, u heeft voorrang in de planning, de supportlijn staat dag en nacht voor u open, en elke dienst wordt tegen ledentarief geoffreerd.`
          : `It starts with membership. For ${company.membership.displayEN} a month your property is on our books: we hold and maintain your property record, you have priority in the schedule, the support line is open to you around the clock, and every service is quoted at member rates.`}
      </p>
      <p class="body-copy">
        {isNl
          ? 'Diensten worden apart geoffreerd, op basis van de werkkaart die u vaststelt. Er zit niets bij in waar u niet om heeft gevraagd, en er begint niets zonder uw schriftelijke akkoord.'
          : 'Services are quoted separately, against the job sheet you approve. Nothing is bundled in that you did not ask for, and nothing starts without your written agreement.'}
      </p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <CtaButton kind="audit" message={auditMessage(locale)} location="home-membership" size="lg">
        {isNl ? 'Plan uw gratis opname' : 'Book your free audit'}
      </CtaButton>
      <CtaButton kind="question" message={whatsappQuestionMessage(locale)} location="home-membership-whatsapp" variant="outline" size="lg">
        {isNl ? 'Stuur ons een WhatsApp-bericht' : 'Message us on WhatsApp'}
      </CtaButton>
    </div>
  </div>
</section>
