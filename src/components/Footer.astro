---
// Identity and legal only — navigation lives in the header now (brief
// Part 5). The statutory block (Row 3) is required by Art. 3:15d BW to be
// real, permanent, static text on every route, not hidden behind a link.
import { company } from '../data/company'
import { legalRoutes } from '../data/routes'

interface Props {
  locale: 'nl' | 'en'
}

const { locale } = Astro.props
const isNl = locale === 'nl'
const year = new Date().getFullYear()

const socialIcons: Record<string, string> = {
  instagram:
    'M12 2c2.7 0 3 .01 4.1.06 1.1.05 1.8.22 2.2.4.5.2.9.5 1.3.9.4.4.7.8.9 1.3.18.4.35 1.1.4 2.2.05 1.1.06 1.4.06 4.1s-.01 3-.06 4.1c-.05 1.1-.22 1.8-.4 2.2-.2.5-.5.9-.9 1.3-.4.4-.8.7-1.3.9-.4.18-1.1.35-2.2.4-1.1.05-1.4.06-4.1.06s-3-.01-4.1-.06c-1.1-.05-1.8-.22-2.2-.4-.5-.2-.9-.5-1.3-.9-.4-.4-.7-.8-.9-1.3-.18-.4-.35-1.1-.4-2.2C2.01 15 2 14.7 2 12s.01-3 .06-4.1c.05-1.1.22-1.8.4-2.2.2-.5.5-.9.9-1.3.4-.4.8-.7 1.3-.9.4-.18 1.1-.35 2.2-.4C9 2.01 9.3 2 12 2zm0 1.8c-2.65 0-2.97.01-4 .06-.97.04-1.5.2-1.85.34-.47.18-.8.4-1.15.75-.35.35-.57.68-.75 1.15-.14.35-.3.88-.34 1.85-.05 1.03-.06 1.35-.06 4s.01 2.97.06 4c.04.97.2 1.5.34 1.85.18.47.4.8.75 1.15.35.35.68.57 1.15.75.35.14.88.3 1.85.34 1.03.05 1.35.06 4 .06s2.97-.01 4-.06c.97-.04 1.5-.2 1.85-.34.47-.18.8-.4 1.15-.75.35-.35.57-.68.75-1.15.14-.35.3-.88.34-1.85.05-1.03.06-1.35.06-4s-.01-2.97-.06-4c-.04-.97-.2-1.5-.34-1.85a3.1 3.1 0 0 0-.75-1.15 3.1 3.1 0 0 0-1.15-.75c-.35-.14-.88-.3-1.85-.34-1.03-.05-1.35-.06-4-.06zm0 3.05a5.15 5.15 0 1 1 0 10.3 5.15 5.15 0 0 1 0-10.3zm0 1.8a3.35 3.35 0 1 0 0 6.7 3.35 3.35 0 0 0 0-6.7zm5.35-1.98a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z',
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-1 1.83-2 3.77-2 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.86-3.06-1.87 0-2.16 1.46-2.16 2.96V21h-4V9z',
  google:
    'M21.6 12.23c0-.68-.06-1.36-.18-2H12v3.79h5.4a4.6 4.6 0 0 1-2 3.02v2.5h3.24c1.9-1.75 3-4.32 3-7.31z M12 22c2.7 0 4.97-.89 6.63-2.42l-3.24-2.5c-.9.6-2.05.96-3.39.96-2.6 0-4.8-1.76-5.6-4.12H3.05v2.58A10 10 0 0 0 12 22z M6.4 13.92a6 6 0 0 1 0-3.84V7.5H3.05a10 10 0 0 0 0 9l3.35-2.58z M12 5.98c1.47 0 2.79.5 3.83 1.5l2.87-2.87A9.96 9.96 0 0 0 12 2a10 10 0 0 0-8.95 5.5l3.35 2.58c.8-2.36 3-4.1 5.6-4.1z',
}

const t = {
  privacyLabel: isNl ? 'PRIVACY' : 'PRIVACY',
  privacyBody: isNl
    ? `${company.tradeName}, handelsnaam van ${company.legalName}, beheert woningen en bedrijfspanden in de regio Amsterdam. Wij nemen de bescherming van uw persoonsgegevens serieus. Wat wij verzamelen gebruiken wij om uw vraag te beantwoorden en de diensten te leveren waar u om heeft gevraagd, bewaren wij niet langer dan nodig of wettelijk vereist, en verkopen wij nooit. Alle details staan in onze privacyverklaring.`
    : `${company.tradeName}, a trade name of ${company.legalName}, looks after residential and commercial property in the Amsterdam region. We take the protection of your personal information seriously. What we collect is used to answer your enquiry and deliver the services you have asked for, is kept no longer than we need it or the law requires, and is never sold. The full detail is in our Privacy Statement.`,
  footerLinksLabel: isNl
    ? ['veiligheid', 'faq', 'privacy', 'terms', 'disclaimer', 'complaints', 'cookies', 'accessibility', 'company-details']
    : [],
}

const row4Slugs = ['privacy', 'terms', 'disclaimer', 'complaints', 'cookies', 'accessibility', 'company-details']
const row4 = legalRoutes.filter((r) => row4Slugs.includes(r.slug))
const privacyHref = isNl ? '/privacy/' : '/en/privacy/'
---

<footer class="bg-ink px-5 py-10 text-onDarkSoft md:px-14 md:py-14">
  <div class="content-wrap flex flex-col gap-10">
    <div class="flex items-center justify-between">
      <span class="font-display text-[20px] text-onDark">{company.name}</span>
      <div class="flex items-center gap-4">
        {Object.entries(company.social).map(([key, href]) => (
          <a href={href} aria-label={key} target="_blank" rel="noopener" class="text-onDarkMute hover:text-onDark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={socialIcons[key] ?? ''} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <div class="max-w-[68ch] border-t border-darkRule pt-6">
      <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.14em] text-onDarkMute">{t.privacyLabel}</p>
      <p class="small-copy text-onDarkSoft">
        {t.privacyBody} <a href={privacyHref} class="underline hover:text-onDark">{isNl ? 'privacyverklaring' : 'Privacy Statement'}</a>.
      </p>
    </div>

    <div class="border-t border-darkRule pt-6 text-[13px] text-onDarkSoft">
      <p>
        {company.name} — {isNl ? 'handelsnaam van' : 'a trade name of'} {company.legalName} ·{' '}
        {company.address.street}, {company.address.postcode} {company.address.city}, {company.address.countryName}
      </p>
      <p class="mt-1">
        KvK {company.kvk} · BTW {company.btw} ·{' '}
        <a href={`tel:${company.phone.replace(/\s/g, '')}`} class="hover:text-onDark">{company.phoneDisplay}</a> ·{' '}
        <a href={`mailto:${company.email}`} class="hover:text-onDark">{company.email}</a>
      </p>
    </div>

    <div class="flex flex-col gap-4 border-t border-darkRule pt-6 text-[13px] sm:flex-row sm:items-center sm:justify-between">
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal">
        {row4.map((r) => (
          <a href={isNl ? r.nlPath : r.enPath} class="hover:text-onDark">{isNl ? r.nlTitle : r.enTitle}</a>
        ))}
      </nav>
      <p class="text-onDarkMute">© {year} {company.legalName}</p>
    </div>
  </div>
</footer>
