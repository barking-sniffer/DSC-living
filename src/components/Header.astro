---
// Sticky mega-menu header — brief Part 4. Three panels (Your needs,
// Services, Company), one open at a time, click to open (not hover),
// closed by Escape / outside click / route change. Below 900px the
// panels become an accordion in a full-screen overlay.
import CtaButton from './CtaButton.astro'
import { auditMessage } from '../lib/whatsapp'
import { serviceRoutes, legalRoutes } from '../data/routes'

interface Props {
  locale: 'nl' | 'en'
  path: string // current path, for the language switcher and active state
  altPath: string // the exact counterpart path in the other locale
}

const { locale, altPath } = Astro.props
const isNl = locale === 'nl'
const home = isNl ? '/' : '/en/'
const wonen = isNl ? '/wonen/' : '/en/residential/'
const zakelijk = isNl ? '/zakelijk/' : '/en/commercial/'
const vve = isNl ? '/vve-beheer/' : '/en/vve-management/'
const contact = `${wonen}#contact`

const t = {
  yourNeeds: isNl ? 'Uw situatie' : 'Your needs',
  services: isNl ? 'Diensten' : 'Services',
  company: isNl ? 'Bedrijf' : 'Company',
  contact: isNl ? 'Contact' : 'Contact',
  cta: isNl ? 'Plan uw gratis opname' : 'Book your free audit',
  langLabel: 'NL / EN',
  close: isNl ? 'Sluiten' : 'Close',
  openMenu: isNl ? 'Menu openen' : 'Open menu',
}

const needs = isNl
  ? [
      { h: 'Ik woon er zelf en wil het uit handen geven', sub: 'De wekelijkse routine, volledig geregeld.', href: `${wonen}#bewoond` },
      { h: 'Ik ben weg, of het pand staat leeg', sub: 'Controle, post en toegang terwijl u er niet bent.', href: `${wonen}leegstandsbeheer/` },
      { h: 'Ik verhuur een pand', sub: 'Gereedmaken, vastleggen, één aanspreekpunt.', href: `${wonen}#verhuur` },
      { h: 'Ik verkoop een pand', sub: 'Bezichtigingsklaar tot de sleuteloverdracht.', href: `${wonen}#verkoop` },
      { h: 'Ik zit in een VvE-bestuur', sub: 'Algemene ruimten, keuringen, het MJOP.', href: vve },
      { h: 'Ik heb een bedrijfsruimte', sub: 'Uitstraling, keuringen, reparaties.', href: zakelijk },
    ]
  : [
      { h: 'I live in my home and want it looked after', sub: 'The weekly routine, fully arranged.', href: `${wonen}#bewoond` },
      { h: 'I am away, or the property is empty', sub: 'Checks, post and access while you are away.', href: `${wonen}vacant-property/` },
      { h: 'I am letting a property', sub: 'Prepared, documented, one point of contact.', href: `${wonen}#verhuur` },
      { h: 'I am selling a property', sub: 'Viewing-ready through to the handover.', href: `${wonen}#verkoop` },
      { h: 'I am on a VvE board', sub: 'Communal areas, inspections, the MJOP.', href: vve },
      { h: 'I run a commercial space', sub: 'Presentation, inspections, repairs.', href: zakelijk },
    ]

const wonenServices = serviceRoutes.filter((r) => r.sector === 'wonen')
const zakelijkServices = serviceRoutes.filter((r) => r.sector === 'zakelijk')

const companyLinks = legalRoutes.filter((r) =>
  ['about', 'veiligheid', 'faq', 'reviews', 'company-details', 'careers'].includes(r.slug),
)
---

<header class="site-header" data-header>
  <div class="bar">
    <a class="wordmark" href={home}>DSC Living</a>

    <nav class="primary" aria-label="Primary">
      {[
        { key: 'needs', label: t.yourNeeds },
        { key: 'services', label: t.services },
        { key: 'company', label: t.company },
      ].map((tr) => (
        <button
          type="button"
          class="mega-trigger"
          id={`t-${tr.key}`}
          aria-expanded="false"
          aria-controls={`p-${tr.key}`}
          data-mega-trigger={tr.key}
        >
          {tr.label}
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        </button>
      ))}
      <a class="nav-link" href={contact}>{t.contact}</a>
    </nav>

    <div class="actions">
      <a class="lang" href={altPath} aria-label="Switch language">{t.langLabel}</a>
      <CtaButton kind="audit" message={auditMessage(locale)} location="header" size="md">{t.cta}</CtaButton>
    </div>

    <button id="mobile-menu-toggle" type="button" class="burger" aria-expanded="false" aria-controls="mobile-overlay" aria-label={t.openMenu}>
      <svg width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true"><path d="M0 1H22" stroke="#2A2622" stroke-width="2" /><path d="M0 8H22" stroke="#2A2622" stroke-width="2" /><path d="M0 15H22" stroke="#2A2622" stroke-width="2" /></svg>
    </button>
  </div>

  <div class="mega" id="p-needs" data-mega-panel="needs" role="region" aria-labelledby="t-needs" hidden>
    <div class="inner grid grid-cols-3 gap-x-10 gap-y-6">
      {needs.map((n) => (
        <a href={n.href} class="group block">
          <p class="text-[14px] font-semibold text-ink group-hover:text-accent">{n.h}</p>
          <p class="mt-1 text-[13px] text-muted">{n.sub}</p>
        </a>
      ))}
    </div>
  </div>

  <div class="mega" id="p-services" data-mega-panel="services" role="region" aria-labelledby="t-services" hidden>
    <div class="inner grid grid-cols-2 gap-10">
      <div>
        <p class="eyebrow mb-3">{isNl ? 'WONEN' : 'RESIDENTIAL'}</p>
        <ul class="flex flex-col gap-2.5">
          {wonenServices.map((s) => (
            <li><a href={isNl ? s.nlPath : s.enPath} class="text-[14px] text-inkSoft hover:text-accent">{isNl ? s.nlTitle : s.enTitle}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="eyebrow mb-3">{isNl ? 'VASTGOED' : 'PROPERTY'}</p>
        <ul class="flex flex-col gap-2.5">
          <li><a href={vve} class="text-[14px] text-inkSoft hover:text-accent">{isNl ? 'VvE-beheer' : 'VvE management'}</a></li>
          {zakelijkServices.map((s) => (
            <li><a href={isNl ? s.nlPath : s.enPath} class="text-[14px] text-inkSoft hover:text-accent">{isNl ? s.nlTitle : s.enTitle}</a></li>
          ))}
          <li><a href={vve} class="text-[14px] text-inkSoft hover:text-accent">{isNl ? 'Onderhoud en vakmensen' : 'Maintenance and trades'}</a></li>
          <li><a href={`${wonen}#verhuur`} class="text-[14px] text-inkSoft hover:text-accent">{isNl ? 'Verhuur- en verkoopbegeleiding' : 'Letting and sale support'}</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mega" id="p-company" data-mega-panel="company" role="region" aria-labelledby="t-company" hidden>
    <div class="inner">
      <ul class="flex flex-wrap gap-x-10 gap-y-3">
        {companyLinks.map((c) => (
          <li><a href={isNl ? c.nlPath : c.enPath} class="text-[14px] text-inkSoft hover:text-accent">{isNl ? c.nlTitle : c.enTitle}</a></li>
        ))}
        <li><a href={contact} class="text-[14px] text-inkSoft hover:text-accent">{t.contact}</a></li>
      </ul>
    </div>
  </div>

  <!-- Mobile overlay (below 900px): accordion of the same three groups.
       Visibility is driven purely by the hidden attribute. -->
  <div id="mobile-overlay" class="mobile-overlay flex-col overflow-y-auto bg-paper px-5 py-6" hidden>
    <div class="flex items-center justify-between">
      <span class="font-display text-[20px] text-ink">DSC Living</span>
      <button id="mobile-close" type="button" class="flex h-11 w-11 items-center justify-center" aria-label={t.close}>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M1 1L17 17M17 1L1 17" stroke="#2A2622" stroke-width="2" /></svg>
      </button>
    </div>

    <div class="mt-6 flex flex-col gap-1">
      {[
        { label: t.yourNeeds, items: needs.map((n) => ({ label: n.h, href: n.href })) },
        {
          label: t.services,
          items: [
            { label: isNl ? 'VvE-beheer' : 'VvE management', href: vve },
            ...wonenServices.map((s) => ({ label: isNl ? s.nlTitle : s.enTitle, href: isNl ? s.nlPath : s.enPath })),
            ...zakelijkServices.map((s) => ({ label: isNl ? s.nlTitle : s.enTitle, href: isNl ? s.nlPath : s.enPath })),
          ],
        },
        { label: t.company, items: companyLinks.map((c) => ({ label: isNl ? c.nlTitle : c.enTitle, href: isNl ? c.nlPath : c.enPath })) },
      ].map((group, gi) => (
        <div class="border-b border-rule py-2">
          <button type="button" data-accordion-trigger={gi} aria-expanded="false" aria-controls={`accordion-${gi}`} class="flex w-full items-center justify-between py-3 text-left text-[16px] font-semibold text-ink">
            {group.label}
            <svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1L6 6L11 1" stroke="#2A2622" stroke-width="1.5" /></svg>
          </button>
          <div id={`accordion-${gi}`} data-accordion-panel hidden class="flex flex-col gap-3 pb-4 pl-1">
            {group.items.map((it) => (
              <a href={it.href} class="text-[14px] text-inkSoft" data-mobile-link>{it.label}</a>
            ))}
          </div>
        </div>
      ))}
      <a href={contact} class="border-b border-rule py-4 text-[16px] font-semibold text-ink" data-mobile-link>{t.contact}</a>
      <a href={altPath} class="py-4 text-[14px] font-bold text-inkSoft" data-mobile-link>{t.langLabel}</a>
    </div>

    <CtaButton kind="audit" message={auditMessage(locale)} location="header-mobile" size="lg" class="mt-6 w-full">{t.cta}</CtaButton>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 100;
    background: #faf7f2;
    border-bottom: 1px solid #e3dcd2;
    /* No overflow:hidden here — it would clip the absolutely-positioned panels. */
  }
  .bar {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .wordmark {
    font-family: Newsreader, Georgia, serif;
    font-size: 22px;
    line-height: 1;
    color: #2a2622;
  }
  .primary,
  .actions {
    display: none;
    align-items: center;
  }
  .primary { gap: 4px; }
  .actions { gap: 20px; }
  .mega-trigger,
  .nav-link {
    display: flex;
    align-items: center;
    gap: 4px;
    border-radius: 3px;
    padding: 8px 12px;
    font-size: 13.5px;
    font-weight: 600;
    color: #3e3831;
  }
  .mega-trigger:hover,
  .nav-link:hover,
  .lang:hover,
  .mega-trigger[aria-expanded='true'] {
    color: #b4552f;
  }
  .lang {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #3e3831;
  }
  .burger {
    display: flex;
    height: 44px;
    width: 44px;
    align-items: center;
    justify-content: center;
  }
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: flex;
  }

  /* Desktop only. Below 900px the panels never open and the accordion
     in the overlay is used instead. */
  @media (min-width: 900px) {
    .primary,
    .actions {
      display: flex;
    }
    .burger {
      display: none;
    }
    .mega {
      position: absolute; /* out of document flow */
      left: 0;
      right: 0;
      top: 100%;
      z-index: 99;
      background: #fffcf8;
      border-top: 1px solid #e3dcd2;
      border-bottom: 1px solid #e3dcd2;
      padding: 40px 0;
      box-shadow: 0 12px 24px -16px rgba(42, 38, 34, 0.25);
    }
    .mega > .inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }
  }
  @media (max-width: 899px) {
    .bar {
      height: 64px;
      padding: 0 20px;
    }
    .mega {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-mega-trigger]')]
  const panels = [...document.querySelectorAll<HTMLElement>('[data-mega-panel]')]
  const DESKTOP = window.matchMedia('(min-width: 900px)')

  function closeAll({ refocus = null }: { refocus?: HTMLElement | null } = {}) {
    panels.forEach((p) => {
      p.hidden = true
    })
    triggers.forEach((t) => t.setAttribute('aria-expanded', 'false'))
    if (refocus) refocus.focus()
  }

  function openPanel(key: string) {
    closeAll() // exclusive: siblings close first
    const panel = panels.find((p) => p.dataset.megaPanel === key)
    const trigger = triggers.find((t) => t.dataset.megaTrigger === key)
    if (!panel || !trigger) return
    panel.hidden = false
    trigger.setAttribute('aria-expanded', 'true')
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation()
      const key = trigger.dataset.megaTrigger!
      const isOpen = trigger.getAttribute('aria-expanded') === 'true'
      isOpen ? closeAll() : openPanel(key)
    })
  })

  // Escape closes and returns focus to the trigger that opened it
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return
    const open = triggers.find((t) => t.getAttribute('aria-expanded') === 'true')
    if (open) closeAll({ refocus: open })
  })

  // Click outside the header closes
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) closeAll()
  })

  // Focus leaving the header closes
  header.addEventListener('focusout', (e) => {
    if (!header.contains(e.relatedTarget as Node | null)) closeAll()
  })

  // Clicking a link inside a panel closes it (route change)
  panels.forEach((p) => p.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => closeAll())))

  // Crossing the breakpoint closes, so desktop state never leaks into mobile
  DESKTOP.addEventListener('change', () => {
    closeAll()
    closeMobile()
  })

  // Astro view transitions / any client-side nav
  document.addEventListener('astro:after-swap', () => closeAll())

  // Mobile overlay + accordion
  const mobileToggle = document.getElementById('mobile-menu-toggle')
  const mobileClose = document.getElementById('mobile-close')
  const mobileOverlay = document.getElementById('mobile-overlay')

  function closeMobile() {
    if (mobileOverlay) mobileOverlay.hidden = true
    document.body.style.overflow = ''
    mobileToggle?.setAttribute('aria-expanded', 'false')
  }
  mobileToggle?.addEventListener('click', () => {
    if (mobileOverlay) mobileOverlay.hidden = false
    document.body.style.overflow = 'hidden'
    mobileToggle.setAttribute('aria-expanded', 'true')
  })
  mobileClose?.addEventListener('click', closeMobile)
  document.querySelectorAll('[data-mobile-link]').forEach((a) => a.addEventListener('click', closeMobile))

  document.querySelectorAll<HTMLButtonElement>('[data-accordion-trigger]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls')!)
      if (!panel) return
      const isOpen = btn.getAttribute('aria-expanded') === 'true'
      btn.setAttribute('aria-expanded', String(!isOpen))
      panel.hidden = isOpen
    })
  })

  // Belt and braces: everything closed on load
  closeAll()
  closeMobile()
</script>
