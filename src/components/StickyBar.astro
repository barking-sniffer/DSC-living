---
// Mobile-only sticky bottom bar, revealed after 60% scroll depth. Carries
// the primary audit CTA plus a small WhatsApp icon button (this is the
// mobile stand-in for FloatingWhatsApp, so the two never overlap).
import CtaButton from './CtaButton.astro'
import { waLink, waMessages } from '../lib/whatsapp'

interface Props {
  locale: 'nl' | 'en'
}

const { locale } = Astro.props
const ctaLabel = locale === 'nl' ? 'Plan uw gratis opname' : 'Book your free audit'
---

<div
  id="sticky-bar"
  class="fixed inset-x-0 bottom-0 z-40 items-center gap-3 border-t border-rule bg-surface px-4 py-3 shadow-[0_-2px_12px_rgba(0,0,0,0.08)] transition-transform duration-200"
  data-sticky-bar
>
  <CtaButton kind="audit" message={waMessages.audit} location="sticky-bar" size="lg" class="flex-1">
    {ctaLabel}
  </CtaButton>
  <a
    href={waLink(waMessages.question)}
    target="_blank"
    rel="noopener"
    data-wa-cta
    data-wa-kind="question"
    data-wa-location="sticky-bar-icon"
    aria-label="Chat with DSC Living on WhatsApp"
    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[3px] border border-ink text-ink"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5C10.1 9 9.6 7.8 9.4 7.3c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.1s1 2.5 1.1 2.7c.1.2 2 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.3.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.5-.3z" />
      <path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.6 1.5 5.2L2 22l4.9-1.4C8.4 21.5 10.1 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18c-1.7 0-3.3-.5-4.7-1.3l-.3-.2-3 .8.8-2.9-.2-.3C3.5 14.7 3 13.4 3 12c0-4.9 4-9 9-9s9 4 9 9-4 9-9 9z" />
    </svg>
  </a>
</div>

<style>
  /* Mobile only, hidden by default, revealed by JS past 60% scroll depth.
     The md+ rule is unconditional so this can never appear on tablet/
     desktop even while the is-visible class is set. */
  [data-sticky-bar] {
    display: none;
    transform: translateY(100%);
  }
  [data-sticky-bar].is-visible {
    display: flex;
    transform: translateY(0);
  }
  @media (min-width: 768px) {
    [data-sticky-bar] {
      display: none !important;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]')

  function updateBar() {
    if (!bar) return
    const scrollDepth = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)
    if (scrollDepth > 0.6) bar.classList.add('is-visible')
    else bar.classList.remove('is-visible')
  }

  window.addEventListener('scroll', updateBar, { passive: true })
  window.addEventListener('resize', updateBar)
  updateBar()
</script>
